# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# groq = the rules engine answers; the Groq LLM is called ONLY when the rules cannot understand a message
# none = fully offline rules engine (also what happens automatically when no key is set)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
# LLM_MODEL=openai/gpt-oss-20b
